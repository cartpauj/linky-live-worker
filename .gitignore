node_modules/

# Wrangler build output and local state.
.wrangler/

# Local secret overrides. CF_API_TOKEN belongs in `wrangler secret put`,
# never in a file.
.dev.vars

.DS_Store

# Real configuration, which carries account and zone ids.
#
# Ignored by pattern rather than by exact name so a variant — wrangler.local.toml,
# wrangler.staging.toml — cannot be committed by accident. The template is the one
# deliberate exception.
wrangler*.toml
!wrangler.example.toml

# Local planning notes, not part of the published project.
PHASE2.md
